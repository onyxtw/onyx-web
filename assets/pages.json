```css
:root {
  --bg: #05060a;
  --bg-soft: #0a0d14;
  --surface: rgba(255, 255, 255, 0.04);
  --line: rgba(255, 255, 255, 0.1);
  --text: #edf2f7;
  --muted: #98a2b3;
  --cyan: #00e8df;
  --gold: #d4af37;
  --radius: 24px;
  --max: 1280px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, "Noto Sans TC", sans-serif;
  min-height: 100vh; overflow-x: hidden;
}

/* 格線背景特效 */
body::before {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: -2;
  background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
  background-size: 44px 44px; mask-image: radial-gradient(circle at center, black 26%, transparent 82%);
}

#photon-bg { position: fixed; inset: 0; z-index: -3; }
.grid-overlay { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(circle at 20% 20%, rgba(0,232,223,0.06), transparent 24%); }

/* 導覽列 */
.topbar { position: sticky; top: 0; z-index: 60; backdrop-filter: blur(20px); background: rgba(5,6,10,0.72); border-bottom: 1px solid var(--line); }
.topbar-inner { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 14px 0; }
.brand { color: #fff; text-decoration: none; display: flex; align-items: center; gap: 12px; }
.brand-mark { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--cyan); display: grid; place-items: center; font-weight: bold; background: rgba(0,232,223,0.1); }
.nav { display: flex; gap: 18px; }
.nav-link { color: var(--muted); text-decoration: none; font-size: 12px; text-transform: uppercase; letter-spacing: 0.16em; transition: 0.3s; }
.nav-link:hover, .nav-link.active { color: #fff; }

/* 內容區塊 */
.page-shell { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; padding: 42px 0 88px; }
.panel { border: 1px solid var(--line); background: rgba(255,255,255,0.03); border-radius: var(--radius); padding: 30px; backdrop-filter: blur(18px); }
.eyebrow { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold); font-weight: bold; margin-bottom: 14px; }
.hero-title { font-size: clamp(34px, 6vw, 72px); line-height: 1.1; margin: 0; color: #fff; }

/* 側邊 AI 按鈕樣式 */
.ai-trigger { position: fixed; right: 20px; bottom: 20px; z-index: 120; width: 64px; height: 64px; border-radius: 18px; border: 1px solid var(--cyan); background: var(--bg); color: #fff; cursor: pointer; font-weight: bold; }
.ai-window { position: fixed; right: 20px; bottom: 96px; z-index: 120; width: 380px; height: 520px; display: none; background: rgba(7,10,15,0.96); border: 1px solid var(--cyan); border-radius: 22px; flex-direction: column; overflow: hidden; }
.ai-window.open { display: flex; }

```
